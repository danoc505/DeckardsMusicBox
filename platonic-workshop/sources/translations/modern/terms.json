  "exceptions": {
    "general-introduction": {
      "p0015:the one": "Taylor's 'the one prior to these three' is nature, the one power before growth, nourishment and reproduction; not the One",
      "p0018:the one": "Taylor's 'the one' here means 'the first of two' ('the one ... the other'), not the One",
      "p0096:the one": "Taylor's 'the one' here means 'the first of two' ('the one ... the other'), not the One",
      "p0106:the one": "Taylor's 'the one' here means 'the first of two' ('the one ... the other'), not the One",
      "p0117:the one": "Taylor's 'the one' here means 'the first of two' ('the one ... the other'), not the One",
      "p0144:the one": "Taylor's 'the one' here means 'the first of two' ('the one ... the other'), not the One",
      "p0028:Jupiter": "The Greek of these lines says 'God' (ho theos), which the modern version follows; Taylor's English has 'Jove'",
      "p0080:progression": "'Progression' here is a movement forward that comes to an end, not the procession of beings",
      "p0154:progression": "'The progressions of human understanding' are the steps by which we come to understand, not the procession of beings"
    },
    "proclus-theology": {
      "I.2.p3:the one": "Taylor's 'the one intellect which generated all the beauty of this theology' is a single intellect, not the One",
      "I.2.p4:the one": "Taylor's 'the one form of intellectual prudence' is a single form, not the One",
      "I.3.p4:the one": "Taylor's 'known by the one' is the one in the soul, its highest point, by which it is joined to the henads; not the One itself",
      "I.5.p4:the one": "Taylor's 'the one good' is the Good, which the Philebus calls one; rendered 'the one Good'",
      "I.9.p2:the one": "Taylor's 'the one being' is Parmenides' one being, the being that is one, rendered so; not the One above being",
      "I.10.p3:the one": "Taylor's 'the one and all-perfect power of intellect' is a single power of intellect, not the One",
      "I.13.p7:the one": "'the one ... the other': the first of two, not the One.",
      "I.15.p1:the one": "'the one ... the other': the first of two, not the One.",
      "I.17.p1:the one": "'the one hypostasis', 'the one series': one reality, one series, not the One.",
      "I.19.p2:the one": "'the one of their nature': the oneness of the gods' nature, not the One.",
      "I.25.p2:the one": "'the one secure port': one harbour, not the One.",
      "I.26.p2:the one": "'the one in each order', 'being which participates of the one': the henad shared by each order, the gods' own one, not the first One.",
      "II.2.p4:the one": "'the one should have the power of uniting the many': the one over against the many, not the One.",
      "II.3.p1:the one": "'the one as being more excellent ... the other': the first of two, not the One.",
      "II.3.p6:the one": "'if the one is from the other': the first of two, not the One."
    }
  },
