  {"greek": "φρονησ\\w*|φρονειν", "modern": ["wisdom", "wise"], "term": "phronesis", "link": ["practical wisdom"], "why": "phronēsis: 'practical wisdom' where it is the virtue, 'wisdom' where Plato's words are quoted; Taylor's 'prudence'"},
  {"greek": "σοφια\\w*|σοφιας|σοφιαν", "modern": ["wisdom", "wise"], "why": "sophia: 'wisdom'"},
